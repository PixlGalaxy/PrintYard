# PrintYard backend: copy to backend/.env for local development (npm run dev loads it).
# Every variable is optional; the values below are the defaults.

# HTTP listener
PORT=3000
HOST=0.0.0.0

# Persistent app state (DB printyard.db, secret.key, avatars, branding, logs, engine).
# Container default: /appdata. Dev default: ./appdata (relative to backend/).
APPDATA_ROOT=./appdata

# Model / G-code library (Phase 3). Container default: /data. Dev default: ./data.
DATA_ROOT=./data

# debug | info | warn | error
LOG_LEVEL=info

# Set by CI in the image
APP_VERSION=dev

# TZ=Europe/Madrid

# Optional. When unset, a random secret is generated once and kept in $APPDATA_ROOT/secret.key.
# SESSION_SECRET=

# Dev / safety flags use the PRINTYARD_ prefix (e.g. PRINTYARD_READ_ONLY=1, PRINTYARD_SIM_PRINTER=1,
# PRINTYARD_FAKE_ENGINE=1). The old SLICEDOCK_ names are still read as a fallback but are deprecated.
