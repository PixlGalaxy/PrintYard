{
  "name": "slicedock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SliceDock backend: API, auth and printer bridge for a self-hosted Creality K2 SE panel",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
